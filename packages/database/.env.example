DATABASE_URL="postgresql://user:password@localhost:5432/fit_tracker"

# En local, igual a DATABASE_URL. En producción con Supabase, DATABASE_URL es
# la conexión pooleada (puerto 6543, para la app en Vercel) y DIRECT_URL es la
# conexión directa (puerto 5432, solo para correr migraciones) — ver README > Deploy.
DIRECT_URL="postgresql://user:password@localhost:5432/fit_tracker"
