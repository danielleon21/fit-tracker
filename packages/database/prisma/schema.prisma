generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) + PrismaAdapter ---
// Corre solo en apps/api. Ver CLAUDE.md, seccion "Auth".

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts        Account[]
  sessions        Session[]
  progressEntries ProgressEntry[]
  routines        Routine[]
  workoutSessions WorkoutSession[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Modulo Progreso ---

model ProgressEntry {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  date           DateTime @db.Date
  weightKg       Decimal  @map("weight_kg") @db.Decimal(5, 2)
  idealWeightKg  Decimal? @map("ideal_weight_kg") @db.Decimal(5, 2)
  heightCm       Decimal? @map("height_cm") @db.Decimal(5, 2)
  bodyFatPct     Decimal? @map("body_fat_pct") @db.Decimal(4, 2)
  muscleMassPct  Decimal? @map("muscle_mass_pct") @db.Decimal(4, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("progress_entries")
}

// --- Catalogo de ejercicios (Gym Tracker) ---
// Importado una vez desde la API publica de wger (CC-BY-SA 3.0, atribuir si se
// expone publicamente). No se consulta a wger en vivo: ver
// packages/database/scripts/import-wger-exercises.ts. wgerId es el id original
// en wger, usado como llave de reconciliacion para poder re-importar sin duplicar.

model ExerciseCategory {
  id     String @id @default(cuid())
  wgerId Int    @unique @map("wger_id")
  name   String

  exercises Exercise[]

  @@map("exercise_categories")
}

model Muscle {
  id                String  @id @default(cuid())
  wgerId            Int     @unique @map("wger_id")
  name              String
  nameEn            String? @map("name_en")
  isFront           Boolean @map("is_front")
  imageUrlMain      String? @map("image_url_main")
  imageUrlSecondary String? @map("image_url_secondary")

  primaryFor   Exercise[] @relation("ExercisePrimaryMuscles")
  secondaryFor Exercise[] @relation("ExerciseSecondaryMuscles")

  @@map("muscles")
}

model Equipment {
  id     String @id @default(cuid())
  wgerId Int    @unique @map("wger_id")
  name   String

  exercises Exercise[]

  @@map("equipment")
}

model Exercise {
  id            String   @id @default(cuid())
  wgerId        Int      @unique @map("wger_id")
  uuid          String   @unique
  categoryId    String?  @map("category_id")
  name          String
  nameEn        String?  @map("name_en")
  description   String?  @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category         ExerciseCategory? @relation(fields: [categoryId], references: [id])
  primaryMuscles   Muscle[]          @relation("ExercisePrimaryMuscles")
  secondaryMuscles Muscle[]          @relation("ExerciseSecondaryMuscles")
  equipment        Equipment[]
  routineExercises RoutineExercise[]
  workoutSetLogs   WorkoutSetLog[]

  @@map("exercises")
}

// --- Rutinas y entrenamientos (Gym Tracker) ---
// Una Routine es la plantilla ("Empuje: pecho, hombro y triceps", programada
// los lunes y jueves); un WorkoutSession es un entrenamiento real que
// ocurrio un dia puntual (opcionalmente siguiendo una rutina), y cada set
// hecho ese dia queda en WorkoutSetLog. El heatmap de dias entrenados y el
// historial salen de WorkoutSession; el progreso de peso por ejercicio sale
// de WorkoutSetLog agrupado por exercise. "Completada" para la rutina del dia
// no es un booleano guardado: es que exista un WorkoutSession para hoy.

model Routine {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  daysOfWeek Int[]    @map("days_of_week") // 0=domingo ... 6=sabado
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  sessions  WorkoutSession[]

  @@map("routines")
}

model RoutineExercise {
  id             String   @id @default(cuid())
  routineId      String   @map("routine_id")
  exerciseId     String   @map("exercise_id")
  position       Int
  targetSets     Int?     @map("target_sets")
  targetReps     Int?     @map("target_reps")
  targetWeightKg Decimal? @map("target_weight_kg") @db.Decimal(6, 2)
  notes          String?  @db.Text // ej. "Máquina Hammer Strength, puesto 3"

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([routineId, exerciseId])
  @@map("routine_exercises")
}

model WorkoutSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  routineId String?  @map("routine_id")
  date      DateTime @db.Date
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine?        @relation(fields: [routineId], references: [id], onDelete: SetNull)
  sets    WorkoutSetLog[]

  @@map("workout_sessions")
}

model WorkoutSetLog {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  exerciseId String   @map("exercise_id")
  setNumber  Int      @map("set_number")
  weightKg   Decimal? @map("weight_kg") @db.Decimal(6, 2)
  reps       Int?
  createdAt  DateTime @default(now()) @map("created_at")

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])

  @@map("workout_set_logs")
}

